{
  "name": "image-editing-module",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module/core/index.d.ts",
      "import": "./dist/module/core/index.js"
    },
    "./core": {
      "types": "./dist/module/core/index.d.ts",
      "import": "./dist/module/core/index.js"
    },
    "./react": {
      "types": "./dist/module/react/index.d.ts",
      "import": "./dist/module/react/index.js"
    },
    "./server": {
      "types": "./dist/module/server/index.d.ts",
      "import": "./dist/module/server/index.js"
    },
    "./adapters/apimart": {
      "types": "./dist/module/adapters/apimart/index.d.ts",
      "import": "./dist/module/adapters/apimart/index.js"
    },
    "./guidance": {
      "types": "./dist/module/guidance/index.d.ts",
      "import": "./dist/module/guidance/index.js"
    },
    "./guidance/react": {
      "types": "./dist/module/guidance/react/index.d.ts",
      "import": "./dist/module/guidance/react/index.js"
    },
    "./guidance/server": {
      "types": "./dist/module/guidance/server-index.d.ts",
      "import": "./dist/module/guidance/server-index.js"
    }
  },
  "files": ["dist/module", "README.md"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "harness:check": "node scripts/check_harness.mjs",
    "harness:test": "node --test scripts/check_harness.test.mjs",
    "test:core": "node --import tsx --test tests/core/*.test.ts",
    "test:server": "node --import tsx --test tests/server/*.test.ts",
    "test:adapter": "node --import tsx --test tests/adapters/*.test.ts",
    "test:guidance": "node --import tsx --test tests/guidance/*.test.ts",
    "test:boundary": "node scripts/check-client-boundary.mjs && node --test scripts/check-client-boundary.test.mjs",
    "test:ui": "node --import tsx --test tests/react/*.test.tsx tests/core/image-coordinates.test.ts",
    "test": "npm run test:core && npm run test:ui && npm run test:server && npm run test:adapter && npm run test:guidance && npm run test:boundary",
    "dev": "vite --host 127.0.0.1",
    "example": "tsx examples/react-express/server.ts",
    "build:module": "tsc -p tsconfig.build.json && node scripts/copy-module-assets.mjs",
    "build": "tsc --noEmit && vite build && npm run build:module"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^5.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
